# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used to create staff (teacher) auth accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Termii (https://termii.com) — SMS/WhatsApp reminders. Leave unset to run in
# mock mode (reminders are logged to the server console instead of sent).
TERMII_API_KEY=
TERMII_SENDER_ID=SchoolMgr

# The app's own public origin, used for links that leave the app and come
# back: Supabase auth emails (signup confirmation, password recovery) and the
# Paystack checkout callback. SET THIS IN PRODUCTION. Without it the origin is
# derived from the request's Host header, which the caller controls — enough
# to have a password-reset link mailed to your user pointing at someone else's
# domain. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used as a fallback.
APP_URL=

# REQUIRED for the two Vercel Cron jobs (weekly fee reminders, nightly
# backups) to run at all — they now refuse every request when it is unset,
# rather than accepting the literal header "Authorization: Bearer undefined".
# Vercel sends this header automatically once the variable exists in Project
# Settings > Environment Variables.
CRON_SECRET=

# OpenRouter (https://openrouter.ai) API key for the AI Assistant — routes to
# Claude models via OpenRouter rather than calling Anthropic directly. Leave
# unset to run in mock mode.
OPENROUTER_API_KEY=
# Optional — defaults to anthropic/claude-haiku-4.5.
OPENROUTER_MODEL=

# Paystack (https://paystack.com) secret key — powers online fee payment
# links (parent portal "Pay now" + staff-generated payment links) and their
# webhook-based auto-reconciliation. Leave unset to run in mock mode (Pay
# Now/payment links simulate an instant successful payment for testing).
# Once set, add this app's /api/paystack/webhook URL as a webhook endpoint
# in the Paystack dashboard, subscribed to the "charge.success" event.
PAYSTACK_SECRET_KEY=

# Mock mode marks a fee PAID the moment a parent taps "Pay now", without any
# money moving. In a production deployment that is almost always a missing
# PAYSTACK_SECRET_KEY rather than a choice, so production now refuses to start
# a payment at all instead of faking one. Set this to 1 only for a deployment
# that is a demo on purpose.
ALLOW_MOCK_PAYMENTS=

# Off-site backup target for the nightly per-school snapshot
# (/api/cron/backup-schools). Any S3-compatible store works; Cloudflare R2
# is the cheapest fit — no egress fees and a free tier that covers this
# comfortably. Deliberately a DIFFERENT provider from Supabase, so losing
# the Supabase project doesn't take the backups with it.
#
# R2:  https://<account-id>.r2.cloudflarestorage.com
# S3:  https://s3.<region>.amazonaws.com
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
# R2 ignores the region but still needs one in the signature; "auto" is fine.
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
