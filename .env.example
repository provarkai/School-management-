# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never expose to the browser. Used to create staff (teacher) auth accounts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Termii (https://termii.com) — SMS/WhatsApp reminders. Leave unset to run in
# mock mode (reminders are logged to the server console instead of sent).
TERMII_API_KEY=
TERMII_SENDER_ID=SchoolMgr

# Secret Vercel Cron must send as "Authorization: Bearer <value>" to trigger the
# weekly automated fee reminder job (Project Settings > Environment Variables;
# Vercel sets this header automatically when CRON_SECRET is configured there).
CRON_SECRET=

# OpenRouter (https://openrouter.ai) API key for the AI Assistant — routes to
# Claude models via OpenRouter rather than calling Anthropic directly. Leave
# unset to run in mock mode.
OPENROUTER_API_KEY=
# Optional — defaults to anthropic/claude-haiku-4.5.
OPENROUTER_MODEL=

# Paystack (https://paystack.com) secret key — powers online fee payment
# links (parent portal "Pay now" + staff-generated payment links) and their
# webhook-based auto-reconciliation. Leave unset to run in mock mode (Pay
# Now/payment links simulate an instant successful payment for testing).
# Once set, add this app's /api/paystack/webhook URL as a webhook endpoint
# in the Paystack dashboard, subscribed to the "charge.success" event.
PAYSTACK_SECRET_KEY=
